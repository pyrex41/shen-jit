(set json-memory.passed 0)
(set json-memory.failed 0)
(define json-memory.check
  Name Expected F ->
    (let Actual (trap-error (thaw F) (/. X [raised (error-to-string X)]))
      (if (= Actual Expected) (set json-memory.passed (+ 1 (value json-memory.passed)))
          (do (set json-memory.failed (+ 1 (value json-memory.failed)))
              (output "FAIL ~A: ~S~%" Name Actual)))))
(if (trap-error (do (memory.free (memory.alloc 1)) false)
      (/. X (if (= (error-to-string X) "foreign: this static build cannot load libraries")
                true (simple-error (error-to-string X)))))
    (do (output "0 passed, 0 failed (static build: foreign JSON input unavailable)~%") (shen-jit.exit 0)) true)
(let Text "{c#34;keyc#34;:c#34;ownedc#34;}"
     Bytes (shen-jit.string->bytes Text)
     N (shen-jit.bytes-length Bytes)
     M (memory.alloc N)
     _ (shen-jit.copy-bytes M 0 Bytes 0 N)
     Value (json.decode (buffer.wrap M) [])
     _ (memory.free M)
  (json-memory.check "JSON owns decoded foreign strings" [object ["key" "owned"]] (freeze Value)))
(let M (memory.alloc 3)
     _ (shen-jit.copy-bytes M 0 (shen-jit.string->bytes "abc") 0 3)
     ReadOnly (shen-jit.pointer-read-only M)
     B (buffer.builder 3)
     _ (buffer.append! B (buffer.wrap ReadOnly))
     _ (shen-jit.pointer-kill ReadOnly)
     _ (memory.free M)
  (json-memory.check "builder copies read-only foreign source" "abc" (freeze (buffer.string (buffer.finish B)))))
(let M (memory.alloc 1)
     V (buffer.wrap M)
     B (buffer.builder 2)
     _ (buffer.append-byte! B 120)
     _ (memory.free M)
     Raised (trap-error (do (buffer.append! B V) false) (/. X true))
  (do (json-memory.check "closed source rejected before append" true (freeze Raised))
      (json-memory.check "failed foreign append leaves bytes intact" "x" (freeze (buffer.string (buffer.finish B))))))
(output "~A passed, ~A failed~%" (value json-memory.passed) (value json-memory.failed))
