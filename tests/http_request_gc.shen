\\ Libraries are already in the image; every allocation here collects.
(let Head (buffer.from-string "POST / HTTP/1.1c#13;c#10;Host: localhostc#13;c#10;Content-Length: 3c#13;c#10;c#13;c#10;")
     Parsed (hd (tl (http.parse-request Head 3)))
     E (io.input-buffer (buffer.from-string "abcNEXT"))
     R (io.reader E [[chunk-size 1]])
     Full (hd (tl (http.read-body (http.body-reader R Parsed))))
     Wire (http.encode-response Full (http.response 200 [] (http.body Full)) 1024 3)
     Tail (hd (tl (io.read-all R 4)))
     _ (io.close E)
     _ (shen-jit.collect)
  (if (and (= (http.method Full) "POST")
           (= (buffer.string (http.body Full)) "abc")
           (= (buffer.string Tail) "NEXT")
           (= (buffer.string Wire)
              "HTTP/1.1 200 OKc#13;c#10;Content-Length: 3c#13;c#10;Connection: closec#13;c#10;c#13;c#10;abc"))
      (output "request gc ok~%")
      (error "HTTP request/response ownership failed under GC stress")))
