(set curl-test.passed 0)
(set curl-test.failed 0)
(let C (curl.open)
     URL (value curl-test.tls)
     Bad (curl-test.error (curl.request C "GET" URL [] (buffer.new 0) [[proxy ""]]))
     Trusted (curl-test.ok (curl.request C "GET" URL [] (buffer.new 0)
                            [[proxy ""] [ca-file (value curl-test.ca)]]))
     Reset (curl-test.error (curl.request C "GET" URL [] (buffer.new 0) [[proxy ""]]))
     Host (curl-test.error (curl.request C "GET" (value curl-test.wrong-host) [] (buffer.new 0)
                            [[proxy ""] [ca-file (value curl-test.ca)]]))
     Downgrade (curl-test.error (curl.request C "GET" (value curl-test.downgrade) [] (buffer.new 0)
                                 [[proxy ""] [ca-file (value curl-test.ca)] [redirect-limit 1]]))
     _ (curl.close C)
  (do (curl-test.check "untrusted certificate rejected" 60 (freeze (io.error-code Bad)))
      (curl-test.check "explicit CA trusted" 200 (freeze (curl.status Trusted)))
      (curl-test.check "trusted TLS body" 1024 (freeze (buffer.length (curl.body Trusted))))
      (curl-test.check "CA policy resets even with a reusable handle" 60 (freeze (io.error-code Reset)))
      (curl-test.check "hostname verification stays enabled" 60 (freeze (io.error-code Host)))
      (curl-test.check "HTTPS redirect cannot downgrade to HTTP" 1 (freeze (io.error-code Downgrade)))))
(let Output (buffer.new 1024)
     Sink (io.output-buffer Output)
     Bad (curl-test.error (curl.get-to (value curl-test.tls) Sink [[proxy ""]]))
     R (curl-test.ok (curl.get-to (value curl-test.tls) Sink [[proxy ""] [ca-file (value curl-test.ca)]]))
     _ (io.close Sink)
  (do (curl-test.check "streaming requires trusted TLS" 60 (freeze (io.error-code Bad)))
      (curl-test.check "verified TLS streams body" 1024 (freeze (curl.body-length R)))
      (curl-test.check "verified TLS binary bytes" 255 (freeze (buffer.u8 Output 255)))))
(output "~A passed, ~A failed~%" (value curl-test.passed) (value curl-test.failed))
