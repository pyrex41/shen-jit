\\ Libraries are already in the image: every allocation in this workload collects.
(let E (io.input-buffer (buffer.from-string "abcdefg")) R (io.reader E [[chunk-size 2]])
     A (io.peek R 2) _ (io.consume R 1) B (io.read-all R 6) _ (io.close E)
     Out (buffer.new 7) Sink (io.output-buffer Out) W (io.writer Sink [[chunk-size 2]])
     Write (io.write W (buffer.from-string "1234567")) Close (io.close Sink)
  (if (and (= (buffer.string (hd (tl A))) "ab")
           (and (= (buffer.string (hd (tl B))) "bcdefg")
                (and (= Write [accepted 7]) (and (= Close [ok]) (= (buffer.string Out) "1234567")))))
      (output "managed gc ok~%") (error "I/O ownership failed under GC stress")))
(let Probe (io.open-file (value io-image.path) read)
  (if (= (hd Probe) error)
      (if (= (io.error-message (hd (tl Probe))) "foreign: this static build cannot load libraries")
          (output "native gc unavailable~%") (error "native I/O GC probe failed"))
      (let E (hd (tl Probe)) R (io.reader E [[chunk-size 2]]) A (io.read-all R 3) _ (io.close E)
        (if (= (buffer.string (hd (tl A))) "xyz") (output "native gc ok~%") (error "native I/O GC failed")))))
