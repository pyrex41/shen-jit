\\ Every allocation collects; definitions were loaded before saving the image.
(let A (frame.encode 1 (buffer.from-string "abc") 8)
     B (frame.encode 2 (buffer.new 0) 8)
     Wire (buffer.new 15)
     _ (buffer.copy! Wire 0 A 0 9)
     _ (buffer.copy! Wire 9 B 0 6)
     E (io.input-buffer Wire)
     F (frame.reader (io.reader E [[chunk-size 2]]) 8)
     First (frame.next F)
     Second (frame.next F)
     End (frame.next F)
     Position (frame.position F)
     _ (io.close E)
     _ (shen-jit.collect)
  (if (and (= (hd (tl First)) 1)
           (and (= (buffer.string (hd (tl (tl First)))) "abc")
                (and (= (buffer.length (hd (tl (tl Second)))) 0)
                     (and (= End [eof]) (= Position 15)))))
      (output "frame gc ok~%")
      (error "framing failed under GC stress")))
