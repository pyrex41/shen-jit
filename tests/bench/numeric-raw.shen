\\ The programs of numeric.shen, each with all its loops in one piece of native code, in registers,
\\ for make bench-numeric. Only setting up and reporting stay ordinary Shen.

(define now -> (get-time unix))

(define report
  Name Check T0 -> (output "~A ~A s check ~A~%" Name (- (now) T0) Check))

\\ ---------------------------------------------------------------------------

(define mat.at N I J -> (* 8 (+ (* I N) J)))

(define mat.fill-row
  _ _ _ J N -> done where (>= J N)
  M I F J N -> (do (shen-jit.f64! M (mat.at N I J) (F I J))
                   (mat.fill-row M I F (+ J 1) N)))

(define mat.fill
  _ _ I N -> done where (>= I N)
  M F I N -> (do (mat.fill-row M I F 0 N) (mat.fill M F (+ I 1) N)))

(define-native mat.multiply (A B C N0)
  (word N N0)
  (word Bytes (* N 8))
  (word I 0)
  (loop rows)
  (jump-unless-word (< I N) done)
  (word RowStart (* I Bytes))
  (word RowEnd (+ RowStart Bytes))
  (word J 0)
  (loop columns)
  (jump-unless-word (< J N) next-row)
  (real Acc 0)
  (word AI RowStart)
  (word BI (* J 8))
  (loop terms)
  (jump-unless-word (< AI RowEnd) store)
  (real Acc (+ Acc (* (f64 A AI) (f64 B BI))))
  (word AI (+ AI 8))
  (word BI (+ BI Bytes))
  (again terms)
  (label store)
  (f64! C (+ RowStart (* J 8)) Acc)
  (word J (+ J 1))
  (again columns)
  (label next-row)
  (word I (+ I 1))
  (again rows)
  (label done)
  (return C))

(define mat.trace
  _ I N Acc -> Acc where (>= I N)
  C I N Acc -> (mat.trace C (+ I 1) N (+ Acc (shen-jit.f64 C (mat.at N I I)))))

(define matmul
  N -> (let Bytes (* N 8)
            A (memory.alloc (* N Bytes))
            B (memory.alloc (* N Bytes))
            C (memory.alloc (* N Bytes))
            _ (mat.fill A (/. I J (/ 1.0 (+ I J 1))) 0 N)
            _ (mat.fill B (/. I J (+ 1.0 (* 0.5 (- I J)))) 0 N)
            T0 (now)
            _ (mat.multiply A B C N)
         (report "matmul" (mat.trace C 0 N 0.0) T0)))

\\ ---------------------------------------------------------------------------

(define-native mand.count (Size0 Limit0 Step0)
  (word Size Size0)
  (word Limit Limit0)
  (real Step Step0)
  (word Acc 0)
  (word J 0)
  (loop rows)
  (jump-unless-word (< J Size) done)
  (real CY (+ -1.5 (* J Step)))
  (word I 0)
  (loop columns)
  (jump-unless-word (< I Size) next-row)
  (real CX (+ -2 (* I Step)))
  (real X 0)
  (real Y 0)
  (word N 0)
  (loop iterate)
  (jump-unless-word (< N Limit) counted)
  (real XX (* X X))
  (real YY (* Y Y))
  (jump-unless (> (+ XX YY) 4) inside)
  (jump counted)
  (label inside)
  (real Y (+ (* 2 (* X Y)) CY))
  (real X (+ (- XX YY) CX))
  (word N (+ N 1))
  (again iterate)
  (label counted)
  (word Acc (+ Acc N))
  (word I (+ I 1))
  (again columns)
  (label next-row)
  (word J (+ J 1))
  (again rows)
  (label done)
  (return-word Acc))

(define mandelbrot
  Size Limit -> (let T0 (now)
                     Check (mand.count Size Limit (/ 3.0 Size))
                  (report "mandelbrot" Check T0)))

\\ ---------------------------------------------------------------------------

\\ The matrix times a vector; the transpose differs in which index it adds.
(define-native sn.times (V Out N0)
  (word N N0)
  (word I 0)
  (loop rows)
  (jump-unless-word (< I N) done)
  (real Acc 0)
  (word J 0)
  (loop terms)
  (jump-unless-word (< J N) store)
  (real Acc (+ Acc (* (/ 1 (+ (* 0.5 (+ I J) (+ I J 1)) I 1)) (f64 V (* J 8)))))
  (word J (+ J 1))
  (again terms)
  (label store)
  (f64! Out (* I 8) Acc)
  (word I (+ I 1))
  (again rows)
  (label done)
  (return Out))

(define-native sn.times-t (V Out N0)
  (word N N0)
  (word I 0)
  (loop rows)
  (jump-unless-word (< I N) done)
  (real Acc 0)
  (word J 0)
  (loop terms)
  (jump-unless-word (< J N) store)
  (real Acc (+ Acc (* (/ 1 (+ (* 0.5 (+ I J) (+ I J 1)) J 1)) (f64 V (* J 8)))))
  (word J (+ J 1))
  (again terms)
  (label store)
  (f64! Out (* I 8) Acc)
  (word I (+ I 1))
  (again rows)
  (label done)
  (return Out))

(define sn.at-a-t
  V Out Tmp N -> (do (sn.times V Tmp N)
                     (sn.times-t Tmp Out N)))

(define sn.power
  0 _ _ _ _ -> done
  K U V Tmp N -> (do (sn.at-a-t U V Tmp N)
                     (sn.at-a-t V U Tmp N)
                     (sn.power (- K 1) U V Tmp N)))

(define sn.ones
  _ I N -> done where (>= I N)
  U I N -> (do (shen-jit.f64! U (* I 8) 1.0) (sn.ones U (+ I 1) N)))

(define sn.dot
  _ _ I N Acc -> Acc where (>= I N)
  A B I N Acc -> (sn.dot A B (+ I 1) N (+ Acc (* (shen-jit.f64 A (* I 8)) (shen-jit.f64 B (* I 8))))))

(define spectral
  N -> (let U (memory.alloc (* N 8))
            V (memory.alloc (* N 8))
            Tmp (memory.alloc (* N 8))
            _ (sn.ones U 0 N)
            T0 (now)
            _ (sn.power 10 U V Tmp N)
         (report "spectral" (/ (sn.dot U V 0 N 0.0) (sn.dot V V 0 N 0.0)) T0)))

\\ ---------------------------------------------------------------------------

\\ Every step, each body against those after it, and then each one moved.
(define-native nb.steps (B End0 Steps0 DtBox)
  (real Dt DtBox)
  (word End End0)
  (word Steps Steps0)
  (loop steps)
  (jump-unless-word (> Steps 0) finished)
  (word I 0)
  (loop bodies)
  (jump-unless-word (< I End) move)
  (word J (+ I 56))
  (loop others)
  (jump-unless-word (< J End) next-body)
  (real Dx (- (f64 B I) (f64 B J)))
  (real Dy (- (f64 B (+ I 8)) (f64 B (+ J 8))))
  (real Dz (- (f64 B (+ I 16)) (f64 B (+ J 16))))
  (real D2 (+ (+ (* Dx Dx) (* Dy Dy)) (* Dz Dz)))
  (real Mag (/ Dt (* D2 (sqrt D2))))
  (real MI (* (f64 B (+ I 48)) Mag))
  (real MJ (* (f64 B (+ J 48)) Mag))
  (f64! B (+ I 24) (- (f64 B (+ I 24)) (* Dx MJ)))
  (f64! B (+ I 32) (- (f64 B (+ I 32)) (* Dy MJ)))
  (f64! B (+ I 40) (- (f64 B (+ I 40)) (* Dz MJ)))
  (f64! B (+ J 24) (+ (f64 B (+ J 24)) (* Dx MI)))
  (f64! B (+ J 32) (+ (f64 B (+ J 32)) (* Dy MI)))
  (f64! B (+ J 40) (+ (f64 B (+ J 40)) (* Dz MI)))
  (word J (+ J 56))
  (again others)
  (label next-body)
  (word I (+ I 56))
  (again bodies)
  (label move)
  (word I 0)
  (loop moves)
  (jump-unless-word (< I End) next-step)
  (f64! B I (+ (f64 B I) (* Dt (f64 B (+ I 24)))))
  (f64! B (+ I 8) (+ (f64 B (+ I 8)) (* Dt (f64 B (+ I 32)))))
  (f64! B (+ I 16) (+ (f64 B (+ I 16)) (* Dt (f64 B (+ I 40)))))
  (word I (+ I 56))
  (again moves)
  (label next-step)
  (word Steps (- Steps 1))
  (again steps)
  (label finished)
  (return B))

(define nb.get B I F -> (shen-jit.f64 B (+ (* I 56) (* F 8))))
(define nb.put B I F X -> (shen-jit.f64! B (+ (* I 56) (* F 8)) X))

(define nb.place
  _ I N -> done where (>= I N)
  B I N -> (do (nb.put B I 0 (* 1.25 I))
               (nb.put B I 1 (- 7.0 (* 0.5 I)))
               (nb.put B I 2 (* 0.25 (* I I)))
               (nb.put B I 3 (* 0.125 (- 3.0 I)))
               (nb.put B I 4 (* 0.0625 I))
               (nb.put B I 5 (- 0.03125 (* 0.01 I)))
               (nb.put B I 6 (+ 1.0 (* 0.5 I)))
               (nb.place B (+ I 1) N)))

(define nbody
  N Steps -> (let B (memory.alloc (* N 56))
                  _ (nb.place B 0 N)
                  T0 (now)
                  _ (nb.steps B (* N 56) Steps 0.01)
               (report "nbody" (nb.get B 0 0) T0)))

\\ ---------------------------------------------------------------------------

\\ Every sweep, each colour, each row, and every other cell.
(define-native heat.sweeps (G Stride0 H0 Sweeps0)
  (word Stride Stride0)
  (word H H0)
  (word Sweeps Sweeps0)
  (loop sweeps)
  (jump-unless-word (> Sweeps 0) finished)
  (word Colour 0)
  (loop colours)
  (jump-unless-word (< Colour 2) next-sweep)
  (word J 1)
  (loop rows)
  (jump-unless-word (< J (- H 1)) next-colour)
  (word Row (* J Stride))
  (word I (+ Row (* 8 (+ 1 (bit-and (+ J Colour) 1)))))
  (word End (+ Row (- Stride 8)))
  (loop cells)
  (jump-unless-word (< I End) next-row)
  (f64! G I (* 0.25 (+ (+ (f64 G (- I 8)) (f64 G (+ I 8))) (+ (f64 G (- I Stride)) (f64 G (+ I Stride))))))
  (word I (+ I 16))
  (again cells)
  (label next-row)
  (word J (+ J 1))
  (again rows)
  (label next-colour)
  (word Colour (+ Colour 1))
  (again colours)
  (label next-sweep)
  (word Sweeps (- Sweeps 1))
  (again sweeps)
  (label finished)
  (return G))

(define heat.edge
  _ I End -> done where (>= I End)
  G I End -> (do (shen-jit.f64! G I 100.0) (heat.edge G (+ I 8) End)))

(define heat
  W H Sweeps -> (let Stride (* W 8)
                     G (memory.alloc (* H Stride))
                     _ (heat.edge G 0 Stride)
                     T0 (now)
                     _ (heat.sweeps G Stride H Sweeps)
                  (report "heat" (shen-jit.f64 G (+ (* (/ H 2) Stride) (* 8 (/ W 2)))) T0)))

\\ ---------------------------------------------------------------------------

(matmul 400)
(mandelbrot 400 200)
(spectral 500)
(nbody 64 200)
(heat 512 512 200)
