(defun t-hd-bad () (hd 5))

(defun t-tl-bad () (tl "x"))

(defun t-consp () (+ (if (cons? (cons 1 2)) 1 0) (+ (if (cons? ()) 10 0) (if (cons? 7) 100 0))))

