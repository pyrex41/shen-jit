"Independent tests for each instruction and each primitive path. Each t-
function returns a fixnum or a Boolean computed without =, or raises."

(defun t-move (A B) (let X A (let Y B (- (* X 10) Y))))

(defun t-consts () (let L (cons "s" (cons 1.5 (cons sym (cons () (cons true (cons -7 ())))))) (t-len L 0)))

(defun t-const-values () (if (string? "s") (if (= (hd (tl (cons 0 (cons sym ())))) sym) (+ -7 (hd (cons 10 ()))) 0) 0))

(defun t-len (L N) (if (cons? L) (t-len (tl L) (+ N 1)) N))

(defun t-captures (A B C D E F G H) ((lambda X (+ X (+ A (+ B (+ C (+ D (+ E (+ F (+ G H))))))))) 100))

(defun t-nested-captures (A) (let B 20 (((lambda X (lambda Y (+ A (+ B (+ X Y))))) 300) 4000)))

(defun t-thunk (A) (thaw (freeze (+ A 1))))

(defun t-curried () ((lambda X (lambda Y (- X Y))) 50 8))

(defun t-tail-value (F) (F 41))

(defun t-call-tail-value () (t-tail-value (lambda X (+ X 1))))

(defun t-apply-non-procedure () (let F 1 (F 2)))

(defun t-apply-symbol () (let F t-len (F () 0)))

(defun t-undefined () (no-such-function 1))

(defun t-thunk-with-arg () ((freeze 1) 2))

(defun t-lambda-no-arg () ((lambda X X)))

(defun t-cond (X) (cond ((= X 1) 10) ((= X 2) 20)))

(defun t-cond-1 () (t-cond 1))

(defun t-cond-2 () (t-cond 2))

(defun t-cond-none () (t-cond 3))

(defun t-handler-literal () (trap-error (+ 1 (hd ())) (lambda E 7)))

(defun t-handler-value (H) (trap-error (simple-error "x") H))

(defun t-handler-closure () (t-handler-value (lambda E 8)))

(defun t-handler-nested () (trap-error (+ 1 (trap-error (simple-error "inner") (lambda E (simple-error "outer")))) (lambda E 9)))

(defun t-handler-message () (trap-error (simple-error "abc") (lambda E (t-strlen (error-to-string E)))))

(defun t-strlen (S) (t-strlen-h S 0))

(defun t-strlen-h (S N) (if (= S "") N (if (= S "a") (+ N 1) (if (= S "ab") (+ N 2) (if (= S "abc") (+ N 3) -1)))))

(defun t-handler-escapes () (trap-error (simple-error "x") (lambda E (hd ()))))

(defun t-handler-not-procedure () (trap-error (simple-error "x") 7))

(defun t-handler-unused () (trap-error 5 (lambda E 6)))

(defun t-handler-depth (N) (if (= N 0) (simple-error "d") (trap-error (t-handler-depth (- N 1)) (lambda E (+ N 0)))))

(defun t-and (A B) (and A B))

(defun t-or (A B) (or A B))

(defun t-and-bad () (and true 1))

(defun t-or-bad () (or false 1))

(defun t-if-bad () (if 1 a b))

(defun t-add-real () (+ 1.5 2))

(defun t-add-real-check () (let R (+ 1.5 2) (if (< R 3.6) (if (> R 3.4) 1 0) 0)))

(defun t-sub-overflow () (- (- -2305843009213693951 1) 1))

(defun t-add-overflow () (+ 2305843009213693951 1))

