(defun t-div-real () (let R (/ 1 4) (if (< R 0.26) (if (> R 0.24) 1 0) 0)))

(defun t-div-zero () (/ 1 0))

(defun t-add-non-number () (+ 1 a))

(defun t-less-non-number () (< a 1))

(defun t-compare (A B) (+ (if (< A B) 1 0) (+ (if (> A B) 10 0) (+ (if (<= A B) 100 0) (if (>= A B) 1000 0)))))

(defun t-compare-real () (t-compare 1.5 2))

(defun t-eq-fixnums () (if (= 3 3) (if (= 3 4) 0 1) 0))

(defun t-eq-int-real () (= 8 (+ 0.5 7.5)))

(defun t-eq-strings () (= "abc" "abc"))

(defun t-eq-lists () (= (cons 1 (cons 2 ())) (cons 1 (cons 2 ()))))

(defun t-eq-lists-differ () (= (cons 1 (cons 2 ())) (cons 1 (cons 3 ()))))

(defun t-eq-vectors () (= (absvector 2) (absvector 2)))

