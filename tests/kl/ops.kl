(defun t-error-to-string-bad () (error-to-string 1))

(defun t-tail-loop (N) (if (= N 0) done (t-tail-loop (- N 1))))

(defun t-tail-value-loop (F N) (if (= N 0) done (F F (- N 1))))

(defun t-call-tail-value-loop () (t-tail-value-loop (lambda F (lambda N (if (= N 0) done ((F F) (- N 1))))) 100000))
